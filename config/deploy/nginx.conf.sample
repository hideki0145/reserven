server {
    listen 80;
    server_name reserven.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name reserven.example.com;
    ssl_certificate /etc/letsencrypt/live/reserven.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reserven.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # This single-proxy setup must overwrite client-supplied forwarding headers.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
