<h1>ログイン</h1>

<%= form_with scope: :session, url: login_path, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :email, 'メールアドレス', class: 'form-label' %>
    <%= f.text_field :email, class: 'form-control', value: @login_email %>
  </div>
  <div class="mb-3">
    <%= f.label :password, 'パスワード', class: 'form-label' %>
    <%= f.password_field :password, class: 'form-control' %>
  </div>
  <div class="mb-3 form-check">
    <%= f.check_box :remember_cookies, class: 'form-check-input', checked: @remember_login %>
    <%= f.label :remember_cookies, 'ログイン状態を保持', class: 'form-check-label' %>
  </div>
  <%= f.submit 'ログインする', class: 'btn btn-primary' %>
<% end %>
