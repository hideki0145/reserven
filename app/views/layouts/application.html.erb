<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Reserven" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Reserven">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Load Bootstrap before application overrides, without a CSS build step. %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous">
    <%= stylesheet_link_tag "application", media: "all" %>
    <%= javascript_include_tag "application", defer: true %>
  </head>

  <body>
    <nav class="app-title navbar navbar-expand-lg bg-body-tertiary border-bottom mb-4" aria-label="メインナビゲーション">
      <div class="container gap-2">
        <%= link_to root_path, class: 'navbar-brand d-flex align-items-center gap-2' do %>
          <%= image_tag '/icon.svg', width: 28, height: 28, alt: '', aria: { hidden: true } %>
          <span>Reserven</span>
        <% end %>
        <button type="button" class="navbar-toggler d-lg-none ms-auto" data-navigation-toggle
                aria-label="メニュー" aria-controls="app-navigation" aria-expanded="false" hidden>
          <span class="navbar-toggler-icon" aria-hidden="true"></span>
        </button>
        <ul id="app-navigation" class="app-navigation navbar-nav ms-auto flex-row flex-wrap gap-2 align-items-center">
          <% if current_user %>
            <li class="nav-item"><%= navigation_link '利用状況', status_path, controller: 'statuses' %></li>
            <li class="nav-item"><%= navigation_link '利用履歴', usage_histories_path, controller: 'usage_histories' %></li>
            <li class="nav-item"><%= navigation_link '予約一覧', reservations_path, controller: 'reservations' %></li>
            <% if current_user.admin? %>
              <li class="nav-item"><%= navigation_link 'ユーザ一覧', admin_users_path, controller: 'admin/users' %></li>
              <li class="nav-item"><%= navigation_link '利用設定一覧', admin_items_path, controller: 'admin/items' %></li>
            <% end %>
            <li class="nav-item"><%= button_to 'ログアウト', logout_path, method: :delete, form: { data: { confirm: 'ログアウトします。よろしいですか？' } }, class: 'nav-link btn btn-link' %></li>
          <% else %>
            <li class="nav-item"><%= navigation_link 'ログイン', login_path, controller: 'sessions' %></li>
          <% end %>
        </ul>
      </div>
    </nav>
    <main class="container pb-4">
      <% if flash.notice.present? %>
        <div class="alert alert-success"><%= flash.notice %></div>
      <% end %>
      <% if flash.alert.present? %>
        <div class="alert alert-danger"><%= flash.alert %></div>
      <% end %>
      <%= yield %>
    </main>
    <%= render 'shared/confirmation_dialog', dialog_id: 'action-confirmation', heading: '操作の確認' %>
  </body>
</html>
