<h1 class="h4">アイテム詳細</h1>

<div class="nav justify-content-end">
  <%= link_to '一覧', admin_items_path, class: 'btn btn-outline-secondary' %>
</div>
<div class="table-responsive">
  <table class="table table-hover">
    <tbody>
      <tr>
        <th><%= Item.human_attribute_name(:id) %></th>
        <td><%= @item.id %></td>
      </tr>
      <tr>
        <th><%= Item.human_attribute_name(:name) %></th>
        <td><%= @item.name %></td>
      </tr>
      <tr>
        <th>状態</th>
        <td><%= @item.disabled? ? '無効' : '有効' %></td>
      </tr>
      <tr><th>利用理由</th><td><%= { 'none' => '入力しない', 'optional' => '任意', 'required' => '必須' }.fetch(@item.reason_policy) %></td></tr>
      <tr>
        <th><%= Item.human_attribute_name(:created_at) %></th>
        <td><%= l @item.created_at, format: :timestamp %></td>
      </tr>
      <tr>
        <th><%= Item.human_attribute_name(:updated_at) %></th>
        <td><%= l @item.updated_at, format: :timestamp %></td>
      </tr>
    </tbody>
  </table>
</div>

<%= link_to '編集', edit_admin_item_path, class: 'btn btn-primary me-3' %>
<%= button_to '削除', [:admin, @item], method: :delete, form: { class: 'd-inline', data: { confirm: "アイテム「#{@item.name}」を削除します。よろしいですか？" } }, class: 'btn btn-danger' %>
