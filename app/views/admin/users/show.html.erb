<h1 class="h4">ユーザ詳細</h1>

<div class="nav justify-content-end">
  <%= link_to '一覧', admin_users_path, class: 'btn btn-outline-secondary' %>
</div>
<div class="table-responsive">
  <table class="table table-hover">
    <tbody>
      <tr>
        <th><%= User.human_attribute_name(:id) %></th>
        <td><%= @user.id %></td>
      </tr>
      <tr>
        <th><%= User.human_attribute_name(:name) %></th>
        <td><%= @user.name %></td>
      </tr>
      <tr>
        <th><%= User.human_attribute_name(:email) %></th>
        <td><%= @user.email %></td>
      </tr>
      <tr>
        <th><%= User.human_attribute_name(:admin) %></th>
        <td><%= @user.admin? ? '○' : '×' %></td>
      </tr>
      <tr>
        <th>アカウント</th>
        <td><%= @user.disabled? ? '無効' : '有効' %></td>
      </tr>
      <tr>
        <th><%= User.human_attribute_name(:created_at) %></th>
        <td><%= l @user.created_at, format: :timestamp %></td>
      </tr>
      <tr>
        <th><%= User.human_attribute_name(:updated_at) %></th>
        <td><%= l @user.updated_at, format: :timestamp %></td>
      </tr>
    </tbody>
  </table>
</div>

<%= link_to '編集', edit_admin_user_path, class: 'btn btn-primary me-3' %>
<%= button_to '削除', [:admin, @user], method: :delete, form: { class: 'd-inline', data: { confirm: "ユーザ「#{@user.name}」を削除します。よろしいですか？" } }, class: 'btn btn-danger' %>
