<div class="status-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 pb-3 mb-3 border-bottom">
  <p class="status-greeting mb-0">こんにちは、 <strong><%= current_user.name %></strong> さん</p>
  <div class="text-md-end">
    <div class="d-flex flex-wrap align-items-center justify-content-md-end gap-2">
      <span class="small text-body-secondary">最終更新: <%= time_tag Time.current, format: :timestamp %></span>
      <%= link_to '更新', status_path, class: 'btn btn-outline-secondary btn-sm', data: { refresh_status: true } %>
    </div>
    <div class="status-refresh-notice small mt-1" role="status">
      <span class="text-body-secondary" data-refresh-active>10分毎に自動更新されます。</span>
      <span class="text-warning invisible" data-refresh-paused>入力中のため自動更新を停止しています。</span>
    </div>
  </div>
</div>
<div class="status-list table-responsive position-relative">
  <table class="status-table table table-hover text-nowrap align-middle" role="table" aria-label="アイテムの利用状況" data-auto-refresh>
    <thead class="table-light">
      <tr>
        <th scope="col"><%= Item.human_attribute_name(:name) %></th>
        <th scope="col"><%= "#{Status.model_name.human}(10分毎に自動更新)" %></th>
        <th scope="col"><span class="visually-hidden">操作</span></th>
      </tr>
    </thead>
    <% usage_checked_at = Time.current %>
    <tbody>
      <% if @items.empty? %>
        <tr>
          <td colspan="3" class="text-body-secondary">現在、表示できるアイテムはありません。</td>
        </tr>
      <% end %>
      <% @items.each do |item| %>
        <tr>
          <td class="fw-semibold"><%= item.name %></td>
          <% status = item.status %>
          <% state = item.usage_state(current_user.id, now: usage_checked_at) %>
          <td>
            <% if state != :available %>
              <% if state == :stopped %>
                <span class="badge rounded-pill text-bg-secondary fs-6 mb-2">利用停止中</span>
              <% elsif state == :grace_period %>
                <span class="badge rounded-pill text-bg-warning fs-6 mb-2">🟠 猶予期間中</span>
              <% elsif state == :expired %>
                <span class="badge rounded-pill text-bg-danger fs-6 mb-2">⏰ 期限切れ</span>
              <% else %>
                <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fs-6 mb-2">🔵 利用中</span>
              <% end %>
              <div><span class="text-body-secondary">利用者:</span> <%= status.user.name %><%= '(自分)' if status.user_id == current_user.id %></div>
              <div><span class="text-body-secondary">利用期限:</span> <%= l status.expires_at, format: '%m/%d(%a) %H:%M' %></div>
              <% if state == :grace_period %>
                <div class="small text-body-secondary mt-1">期限後15分の猶予期間中です。</div>
              <% elsif state == :expired %>
                <div class="small text-body-secondary mt-1">他の利用者は利用を開始できます。</div>
              <% end %>
            <% else %>
              <span class="badge rounded-pill text-bg-light border fs-6">✅ 利用可能</span>
            <% end %>
          </td>
          <% if item.can_end_usage?(current_user.id) %>
            <td>
              <% if item.can_extend_usage?(current_user.id) %>
                <%= form_with url: extend_status_path(id: item.id), local: true, class: 'd-flex flex-wrap align-items-start gap-2 mb-2' do |f| %>
                  <%= f.label :expires_at, '延長後の利用期限', for: "extend_status_#{item.id}_expires_at", class: 'visually-hidden' %>
                  <%= render 'deadline_field', f: f, field_id: "extend_status_#{item.id}_expires_at", deadline: [Time.current, status.expires_at].max + 15.minutes %>
                  <span class="pt-2">まで</span>
                  <%= f.submit '延長する', class: 'btn btn-success' %>
                <% end %>
              <% end %>
              <%= form_with url: end_use_status_path(id: item.id), local: true do |f| %>
                <%= f.submit '利用終了', class: 'btn btn-primary' %>
              <% end %>
            </td>
          <% elsif !item.can_start_usage?(current_user.id, now: usage_checked_at) %>
            <td></td>
          <% else %>
            <td>
              <%= form_with url: update_status_path(id: item.id), local: true, class: 'd-flex flex-wrap align-items-start gap-2 mb-2' do |f| %>
                <%= f.label :expires_at, '利用期限', for: "update_status_#{item.id}_expires_at", class: 'visually-hidden' %>
                <%= render 'deadline_field', f: f, field_id: "update_status_#{item.id}_expires_at", deadline: Time.current + 15.minutes %>
                <span class="pt-2">まで</span>
                <%= f.submit '利用する', class: 'btn btn-primary' %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<dialog id="deadline-confirmation" aria-labelledby="deadline-confirmation-title" class="border rounded p-4 shadow" data-preview-url="<%= deadline_preview_path %>">
  <h2 id="deadline-confirmation-title" class="h4">日付をまたぐ利用の確認</h2>
  <p data-confirmation-message class="alert alert-warning my-3"></p>
  <form method="dialog" class="d-flex justify-content-end gap-2">
    <button value="cancel" class="btn btn-outline-secondary" autofocus>戻る</button>
    <button value="confirm" class="btn btn-primary">確定する</button>
  </form>
</dialog>
